{
  "name": "oshi-web-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "3d:dev": "vite --config experiments/wasteland-3d/vite.config.js",
    "3d:build": "vite build --config experiments/wasteland-3d/vite.config.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "jsdom": "^29.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
